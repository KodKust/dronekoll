---
/**
 * Marknadshemmet "/" — engelska; hreflang självrefererande + x-default.
 * Designpass 2026-07-24: samma startsidesarkitektur som de 27 språkindexen
 * (HomeHero + FeatureBand + CountrySearch/CountryGrid + AppCta) — delade
 * komponenter och datakällor så språkversionerna aldrig glider isär.
 * H1-accenten är numera briefing-blå (grönt reserveras för semantik).
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeHero from '../components/HomeHero.astro';
import FeatureBand from '../components/FeatureBand.astro';
import CountrySearch from '../components/CountrySearch.astro';
import CountryGrid from '../components/CountryGrid.astro';
import AppCta from '../components/AppCta.astro';
import { allCountryPages, hubCluster, SITE } from '../lib/model';
import { zoneCountByIso } from '../lib/ingest';
import { t } from '../lib/i18n';
import { organizationLd, webSiteLd, softwareAppLd } from '../lib/seo';

const enPages = allCountryPages()
  .filter((p) => p.lang === 'en')
  .sort((a, b) => a.displayName.localeCompare(b.displayName, 'en'));
const totalCountries = enPages.length;
const totalZones = Object.values(zoneCountByIso()).reduce((a, b) => a + b, 0);

const title = t('meta.title.home', 'en', { brand: 'DroneKoll', n: totalCountries });
const description = t('meta.desc.home', 'en', { n: totalCountries });
// "/" ÄR den engelska hubben och bär därför hela 27-språksklustret — inte bara
// sig själv. Tidigare deklarerade den bara en+x-default, medan /en/ bar alla 27:
// besökaren som landade här hittade ingen väg till sitt språk, och Google såg
// två engelska sidor utan att veta vilken som gällde. hubCluster() pekar nu
// engelskan hit, så samma funktion tjänar alla 27 hubbar. Se model.ts.
const alternates = hubCluster();
const ldBlocks = [organizationLd(), webSiteLd('en'), softwareAppLd('en')];
---

<Base
  title={title}
  description={description}
  lang="en"
  alternates={alternates}
  ogImage="https://dronekoll.com/og/home.jpg"
>
  <Fragment slot="head">
    {ldBlocks.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </Fragment>

  <Header lang="en" cluster={alternates} />

  <main id="main-content">
    <HomeHero lang="en" totalCountries={totalCountries} totalZones={totalZones} />

    <FeatureBand lang="en" />

    {/* ── Landsväljare ─────────────────────────────────────────────────── */}
    <section class="band band--canvas">
      <div class="shell">
        <h2 class="home-grid-title">{t('home.countries.title', 'en')}</h2>
        <CountrySearch lang="en" total={totalCountries} />
        <CountryGrid lang="en" pages={enPages} />
      </div>
    </section>

    {/* ── App-CTA ──────────────────────────────────────────────────────── */}
    <section class="band band--paper">
      <div class="wide">
        <AppCta lang="en" />
      </div>
    </section>
  </main>

  <Footer lang="en" />
</Base>

<style>
  .home-grid-title { margin-bottom: var(--space-5); }
</style>
