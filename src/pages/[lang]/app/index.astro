---
/**
 * App-översikten — /{lang}/app/ : de fyra funktionerna som kort + stor CTA.
 * Navet mellan kunskapssidorna (länder) och produktytan (funktioner).
 * Designpass 2026-07-24: delad hero — text till vänster, den befintliga
 * app-/kartbilden som kontrollerad visual till höger (inte en helskärmsbanner);
 * nästa innehåll börjar synas inom en vanlig laptopskärm. Den nya transparenta
 * hero-drönaren används medvetet INTE här (den är startsidans varumärkesbild —
 * här ska visualen förklara appen).
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FeatureCard from '../../../components/FeatureCard.astro';
import AppCta from '../../../components/AppCta.astro';
import { LANGUAGE_CODES, loadFeatures, featureCluster, brandForLang } from '../../../lib/model';
import { t } from '../../../lib/i18n';
import { softwareAppLd, organizationLd, webSiteLd } from '../../../lib/seo';

export function getStaticPaths() {
  return LANGUAGE_CODES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const brand = brandForLang(lang);
const cluster = featureCluster(null);

const title = t('app.overview.title', lang, { brand });
const description = t('app.overview.desc', lang);

const features = loadFeatures().map((f) => ({
  slug: f.slug,
  name: t(`feat.${f.slug}.name`, lang),
  lede: t(`feat.${f.slug}.desc`, lang),
  image: existsSync(join(process.cwd(), 'public', 'device', f.slug, `${lang}.webp`))
    ? `/device/${f.slug}/${lang}.webp`
    : undefined,
}));

const heroImage = existsSync(join(process.cwd(), 'public', 'img', 'app-hero.webp'));
const ldBlocks = [organizationLd(), webSiteLd(lang), softwareAppLd(lang)];
---

<Base title={title} description={description} lang={lang} alternates={cluster}>
  <Fragment slot="head">
    {ldBlocks.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </Fragment>

  <Header lang={lang} cluster={cluster} />

  <main id="main-content">
  <section class="band band--paper app-hero">
    <div class="shell app-hero__grid">
      <div class="hero-seq app-hero__copy">
        <Breadcrumbs items={[{ label: t('bc.home', lang), href: `/${lang}/` }, { label: t('app.bc', lang) }]} />
        <h1>
          {t('app.overview.h1.pre', lang)}{' '}
          <span class="h-accent">{t('app.overview.h1.accent', lang)}</span>
        </h1>
        <p class="lede app-hero__lede">{t('app.overview.lede', lang, { brand })}</p>
      </div>
      {heroImage && (
        <div class="app-hero__visual">
          <img src="/img/app-hero.webp" alt="" width="1400" height="933" loading="eager" decoding="async" />
        </div>
      )}
    </div>
  </section>

  <section class="band band--canvas">
    <div class="shell">
      <ul class="featgrid" data-stagger>
        {features.map((f) => (
          <li>
            <FeatureCard href={`/${lang}/app/${f.slug}/`} name={f.name} desc={f.lede} image={f.image} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band--paper">
    <div class="wide">
      <AppCta lang={lang} />
    </div>
  </section>
  </main>

  <Footer lang={lang} />
</Base>

<style>
  .app-hero { padding-block: clamp(40px, 6vw, 68px); }
  .app-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 44%);
    gap: clamp(var(--space-5), 4vw, var(--space-8));
    align-items: center;
  }
  .app-hero__copy { display: grid; gap: var(--space-4); min-width: 0; }
  .app-hero__lede { max-width: 52ch; }
  .app-hero__visual img {
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-3);
  }
  .featgrid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: var(--space-5);
  }
  .featgrid > li { display: grid; }
  @media (max-width: 880px) {
    .app-hero__grid { grid-template-columns: 1fr; }
    .app-hero__visual { order: 2; }
  }
</style>
