---
/**
 * Landssidan — sajtens kärna. En per språk × land (~98 st) ur modellen.
 * Bandrytm (CAVOK): hero(paper) → snabbfakta(canvas) → regler(paper) →
 * karta(canvas) → FAQ(canvas efter zontyper-fas 4) → noter+källor(paper) →
 * app-CTA → navy-footer. Register: briefing (blå accent), aldrig säljtryck.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AnchorNav from '../../../components/AnchorNav.astro';
import QuickFacts from '../../../components/QuickFacts.astro';
import RuleList from '../../../components/RuleList.astro';
import Callout from '../../../components/Callout.astro';
import SourceLinks from '../../../components/SourceLinks.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import FreshnessBadge from '../../../components/FreshnessBadge.astro';
import MapSection from '../../../components/MapSection.astro';
import AppCta from '../../../components/AppCta.astro';
import CountryGrid from '../../../components/CountryGrid.astro';
import { allCountryPages, relatedCountries, enArticle, type PageEntry } from '../../../lib/model';
import { splitCountryHeading } from '../../../lib/country-forms.mjs';
import { zoneCountByIso } from '../../../lib/ingest';
import { mapConfigFor } from '../../../lib/mapconfig';
import { t } from '../../../lib/i18n';
import {
  countryTitle,
  countryDescription,
  webPageLd,
  breadcrumbLd,
  faqLd,
  softwareAppLd,
  organizationLd,
  buildFaq,
} from '../../../lib/seo';

export function getStaticPaths() {
  return allCountryPages().map((page) => ({
    params: { lang: page.lang, slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: PageEntry;
}
const { page } = Astro.props;
const c = page.country;
const lang = page.lang;
const year = new Date().getFullYear();
const related = relatedCountries(page, 4);

const title = countryTitle(page);
const description = countryDescription(page);
const zoneCount = zoneCountByIso()[page.iso];
const mapConfig = c.hasAirspaceOverlay ? mapConfigFor(page.iso, lang) : null;
// Statisk Voyager-crop (render_static_maps.py): huvudkarta för icke-overlay,
// fallback för overlay-länder utan aktiva lager (MapSection avgör).
const staticMapPath = `/static-maps/${page.iso.toLowerCase()}.webp`;
const staticImage = existsSync(
  join(process.cwd(), 'public', 'static-maps', `${page.iso.toLowerCase()}.webp`),
)
  ? staticMapPath
  : undefined;
const faqItems = buildFaq(page, { interactiveMap: !!mapConfig });

// Två-tons-H1: accent-span på landsnamnet (briefing-registret = blått).
// Mallen splittas vid SIN EGEN platshållare — {country}, eller {countryIn}/
// {countryGen} där språket böjer namnet i stället för att sätta preposition
// framför (finskan). Ingen sentinel behövs: platshållaren i råmallen ÄR
// splitpunkten. splitCountryHeading kastar om mallen bär en platshållare vi
// inte kan fylla — bygget ska falla, inte rendera "{countryIn}" synligt.
const h1 = splitCountryHeading(t('hero.h1.country', lang), {
  iso: page.iso,
  lang,
  displayName: page.displayName,
});

const sections = [
  'rules',
  'map',
  ...(faqItems.length > 0 ? (['faq'] as const) : []),
  'sources',
] as Array<'rules' | 'map' | 'zones' | 'faq' | 'sources'>;

const ldBlocks = [
  webPageLd(page, title, description),
  breadcrumbLd(page),
  ...(faqItems.length > 0 ? [faqLd(faqItems)] : []),
  softwareAppLd(lang),
  organizationLd(),
];
---

<Base
  title={title}
  description={description}
  lang={lang}
  alternates={page.cluster}
  ogImage={existsSync(join(process.cwd(), 'public', 'og', lang, `${page.slug}.jpg`))
    ? `https://dronekoll.com/og/${lang}/${page.slug}.jpg`
    : undefined}
>
  <Fragment slot="head">
    {ldBlocks.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
    {/* Smart App Banner (endast iOS Safari): "Öppna" med installerad app
        levererar app-argument till appens deep-link-parser (besöksläge:
        detta land + sidans språk); utan app visas App Store-knapp.
        Bara landssidor — hubbar/hem saknar land. */}
    <meta
      name="apple-itunes-app"
      content={`app-id=6761332194, app-argument=dronarkartan://open?country=${page.iso}&lang=${lang}&src=banner`}
    />
  </Fragment>

  <Header lang={lang} cluster={page.cluster} />

  <main id="main-content">
  {/* ── Hero ─────────────────────────────────────────────────────────── */}
  <section class="band band--paper hero">
    <div class="content hero-seq">
      <Breadcrumbs
        items={[
          { label: t('bc.home', lang), href: `/${lang}/` },
          { label: page.displayName },
        ]}
      />
      <img
        class="hero__flag"
        src={`/flags/${page.iso.toLowerCase()}.svg`}
        width="40"
        height="40"
        alt=""
        decoding="async"
      />
      <h1>
        {h1.pre}{h1.article}<span class="h-accent">{h1.accent}</span>{h1.post}
      </h1>
      <p class="lede prose">{t('hero.lede.country', lang)}</p>
      {/* Endast freshness-badgen: myndighet/regelverk/karta fanns tidigare
          som chip här men dubblerades av snabbfakta-korten och ankarnavet
          direkt nedanför ("kaka på kaka", Kristoffer 2026-07-30). */}
      <div class="hero__meta">
        <FreshnessBadge
          lang={lang}
          iso={page.iso}
          lastVerified={c.lastVerified}
          monitored={c.hasAirspaceOverlay}
        />
      </div>
    </div>
  </section>

  <AnchorNav lang={lang} sections={sections} />

  {/* ── Snabbfakta ───────────────────────────────────────────────────── */}
  <section class="band band--canvas" aria-labelledby="quickanswer-heading">
    <div class="wide">
      <div class="quick-answer">
        <Callout
          kind="note"
          title={t('quickanswer.title', lang)}
          titleAs="h2"
          titleId="quickanswer-heading"
        >
          {t('quickanswer.body', lang, { country: enArticle(page.iso, lang) ? 'The ' + page.displayName : page.displayName, year })}
        </Callout>
      </div>
      <QuickFacts page={page} zoneCount={zoneCount} />
    </div>
  </section>

  {/* ── Regler ───────────────────────────────────────────────────────── */}
  <section class="band band--paper" id="rules" aria-labelledby="rules-heading">
    <div class="content">
      <h2 class="overline" id="rules-heading">{c.sectionLabelRules ?? t('anchor.rules', lang)}</h2>
      <RuleList rules={c.keyRules} />
    </div>
  </section>

  {/* ── Karta ────────────────────────────────────────────────────────── */}
  <section class="band band--canvas" id="map" aria-labelledby="map-heading">
    <div class="wide">
      <h2 class="section-title" id="map-heading">{t('map.title', lang)}</h2>
      {zoneCount && (() => {
        const [pre, post = ''] = t('freshness.zonesLive', lang, { n: '__N__' }).split('__N__');
        return (
          <p class="small map-zoneline tnum">
            {pre}
            <span data-countup={zoneCount} data-lang={lang}>{zoneCount.toLocaleString(lang)}</span>
            {post}
          </p>
        );
      })()}
      <MapSection page={page} mapConfig={mapConfig} staticImage={staticImage} />
    </div>
  </section>

  {/* ── FAQ ──────────────────────────────────────────────────────────── */}
  {faqItems.length > 0 && (
    <section class="band band--paper" id="faq" aria-labelledby="faq-heading">
      <div class="content">
        <h2 class="section-title" id="faq-heading">{t('faq.title', lang)}</h2>
        <FaqBlock items={faqItems} />
      </div>
    </section>
  )}

  {/* ── Noter + källor ───────────────────────────────────────────────── */}
  {/* Bandet behåller id="sources" — ankarnavet OCH dess IntersectionObserver
      observerar just detta element, och en flytt av id:t skulle ändra när
      pillen tänds. "Bra att veta" och källorna får i stället var sitt eget
      <section> INUTI bandet: rätt rubrikstruktur, och eftersom de förblir
      direkta griddbarn av .sources-band ändras inte en enda pixel. */}
  <section class="band band--canvas" id="sources">
    <div class="content sources-band">
      {c.importantNotes.length > 0 && (
        <section class="notes" aria-labelledby="notes-heading">
          <h2 class="section-title" id="notes-heading">{t('notes.title', lang)}</h2>
          <div class="notes__list">
            {c.importantNotes.map((note) => (
              <Callout kind="note">{note}</Callout>
            ))}
          </div>
        </section>
      )}

      <section aria-labelledby="sources-heading">
        <h2 class="overline sources-label" id="sources-heading">{c.sectionLabelPrimary ?? t('anchor.sources', lang)}</h2>
        <SourceLinks links={c.primaryLinks} />
      </section>

      {c.secondaryLinks.length > 0 && (
        <section aria-labelledby="sources-secondary-heading">
          <h2 class="overline sources-label" id="sources-secondary-heading">{c.sectionLabelSecondary}</h2>
          <SourceLinks links={c.secondaryLinks} />
        </section>
      )}

      {c.disclaimerText && <p class="small disclaimer">{c.disclaimerText}</p>}
    </div>
  </section>

  {/* ── App-CTA ──────────────────────────────────────────────────────── */}
  <section class="band band--paper">
    <div class="wide">
      <AppCta
        lang={lang}
        bodyKey={c.hasAirspaceOverlay ? 'cta.body' : c.hasNotam ? 'cta.body.notam' : 'cta.body.base'}
        deviceImage={existsSync(join(process.cwd(), 'public', 'device', `${lang}.webp`))
          ? `/device/${lang}.webp`
          : undefined}
        deviceImage2={existsSync(join(process.cwd(), 'public', 'device', 'flight-log', `${lang}.webp`))
          ? `/device/flight-log/${lang}.webp`
          : undefined}
        deviceAlt={t('cta.appstore.alt', lang)}
      />
    </div>
  </section>

  {/* ── Relaterade länder (intern länkning — B5) ─────────────────────── */}
  {related.length > 0 && (
    <section class="band band--canvas" id="related">
      <div class="wide">
        <h2 class="section-title">{t('related.title', lang)}</h2>
        <CountryGrid lang={lang} pages={related} />
      </div>
    </section>
  )}
  </main>

  <Footer lang={lang} />
</Base>

<style>
  .hero .content { display: grid; gap: var(--space-4); }
  .hero__flag { width: 40px; height: 40px; border-radius: 50%; box-shadow: var(--shadow-1); }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin-top: var(--space-2);
    /* KRITISK: .content är en grid; utan min-width:0 kan ett långt barn
       blåsa upp grid-kolumnen → hela sidan bredare än viewporten på mobil.
       (2026-07-15, mobil-overflow-läxan) */
    min-width: 0;
    max-width: 100%;
  }
  .section-title { margin-bottom: var(--space-5); }
  .quick-answer { margin-bottom: var(--space-5); }
  #rules .overline { margin-bottom: var(--space-5); }
  .map-zoneline { color: var(--ink-2); margin: calc(-1 * var(--space-4)) 0 var(--space-4); }
  .sources-band { display: grid; gap: var(--space-7); }
  .notes__list { display: grid; gap: var(--space-3); max-width: var(--w-prose); }
  .sources-label { margin-bottom: var(--space-4); }
  .disclaimer { color: var(--ink-2); font-style: italic; max-width: var(--w-prose); }
</style>
