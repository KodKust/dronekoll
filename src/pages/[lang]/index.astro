---
/**
 * Språkindex — /{lang}/ för alla 27 språk. Designpass 2026-07-24: SAMMA
 * startsidesarkitektur som "/" (HomeHero + FeatureBand + CountrySearch +
 * landsgrid + AppCta) via gemensamma komponenter och datakällor — inga
 * äldre lokala kopior. Innehållet är översatt (web-strings/feature-strings,
 * 27/27-täckning verifierad); metadata behåller hubbens katalogvinkel.
 * Efter språkmatrisen (55×27) har varje språk alla länder lokalt; den
 * engelska fallback-sektionen renderas bara om ett språk saknar länder.
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HomeHero from '../../components/HomeHero.astro';
import FeatureBand from '../../components/FeatureBand.astro';
import CountrySearch from '../../components/CountrySearch.astro';
import CountryGrid from '../../components/CountryGrid.astro';
import AppCta from '../../components/AppCta.astro';
import {
  LANGUAGE_CODES,
  allCountryPages,
  countriesForLang,
  hubCluster,
  brandForLang,
  SITE,
  siteCounts,
} from '../../lib/model';
import { t } from '../../lib/i18n';
import { zoneCountByIso } from '../../lib/ingest';
import { organizationLd, webSiteLd } from '../../lib/seo';

export function getStaticPaths() {
  return LANGUAGE_CODES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const localPages = countriesForLang(lang).sort((a, b) =>
  a.displayName.localeCompare(b.displayName, lang),
);
const enPages =
  lang === 'en'
    ? []
    : allCountryPages()
        .filter((p) => p.lang === 'en' && !localPages.some((lp) => lp.iso === p.iso))
        .sort((a, b) => a.displayName.localeCompare(b.displayName, 'en'));

const totalCountries = new Set(allCountryPages().map((p) => p.iso)).size;
const totalZones = Object.values(zoneCountByIso()).reduce((a, b) => a + b, 0);
const title = t('meta.title.hub', lang, { brand: brandForLang(lang) });
const description = t('meta.desc.hub', lang, siteCounts());
const ldBlocks = [organizationLd(), webSiteLd(lang)];

// /en/ är en dublett av "/" — samma H1, ~1 % textskillnad — och pekar därför ut
// "/" som originalet. Sidan ligger kvar (inkommande länkar ska inte dö) men
// konkurrerar inte längre med "/" om samma sökning. En 301 vore renare, men
// GitHub Pages lämnar bara ut färdiga filer och kan inte omdirigera.
const canonical = lang === 'en' ? `${SITE}/` : undefined;
// ...och bär då INGA hreflang-alternativ. En sida som pekar ut någon annan som
// original ska inte stå i språkgrafen — "/" bär hela klustret för engelskan.
// Låter man /en/ ligga kvar i grafen bryts dessutom reciprociteten: de 26 andra
// hubbarna pekar på "/", inte tillbaka på /en/. Språkväljaren i Header är UI och
// får hubCluster() oavsett — besökaren ska kunna byta språk även här.
---

<Base title={title} description={description} lang={lang} alternates={lang === 'en' ? [] : hubCluster()} canonical={canonical}>
  <Fragment slot="head">
    {ldBlocks.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </Fragment>

  <Header lang={lang} cluster={hubCluster()} />

  <main id="main-content">
    <HomeHero lang={lang} totalCountries={totalCountries} totalZones={totalZones} />

    <FeatureBand lang={lang} />

    {/* ── Landsväljare ─────────────────────────────────────────────────── */}
    <section class="band band--canvas">
      <div class="shell hub-grids">
        <h2 class="home-grid-title">{t('home.countries.title', lang)}</h2>
        <CountrySearch lang={lang} total={localPages.length + enPages.length} />
        {localPages.length > 0 && <CountryGrid lang={lang} pages={localPages} />}
        {enPages.length > 0 && (
          <div>
            <p class="overline hub-label">{t('hub.allInEnglish', lang)}</p>
            <CountryGrid lang={lang} pages={enPages} />
          </div>
        )}
      </div>
    </section>

    {/* ── App-CTA ──────────────────────────────────────────────────────── */}
    <section class="band band--paper">
      <div class="wide">
        <AppCta lang={lang} />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Base>

<style>
  .home-grid-title { margin-bottom: var(--space-5); }
  .hub-grids > * + :global(.cgrid) { margin-top: 0; }
  .hub-label { margin-block: var(--space-6) var(--space-4); }
</style>
