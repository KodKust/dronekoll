---
/**
 * Feed-status-badge — visas BARA när ett övervakat lands luftrumsFEED är
 * degraderad (src/scripts/freshness.ts läser pappilappi status.json och tar
 * bort `hidden`). Normalläge = ingen badge alls.
 *
 * Datumstämpeln "Regler kontrollerade {datum}" (lastVerified) är borttagen
 * 2026-09-24 på Kristoffers beslut, i linje med zonstämpeln 1/9 (dronarkartan
 * LOGG Fas 489): datumet sattes när någon sparade filen men lästes som att
 * reglerna kontrollerats mot myndigheten — efter källförvaltningen 23/9 visade
 * det april–juni på texter som rättats samma dag. Källänkarna står kvar.
 * Feed-status får fortfarande ALDRIG påstå något om reglerna (REPO-P0-03).
 */
import { t } from '../lib/i18n';

interface Props {
  lang: string;
  iso: string;
  /** landet finns i status.json (19 övervakade) → klient-uppgradering aktiveras */
  monitored?: boolean;
}
const { lang, iso, monitored = false } = Astro.props;
---

{monitored && (
  <span
    class="pill freshness"
    hidden
    data-freshness={iso}
    data-lang={lang}
    data-msg-warn={t('freshness.liveWarn', lang)}
  >
    <span class="pulse-dot" aria-hidden="true"></span>
    <span class="freshness__text tnum"></span>
  </span>
)}

{/* No-op:ar utan [data-freshness] — villkorade hoisted scripts är opålitliga. */}
<script>
  import '../scripts/freshness';
</script>

<style>
  .freshness {
    background: var(--go-wash);
    color: var(--go-ink);
    font-weight: 500;
    font-size: var(--text-caption);
    min-height: 28px;
  }
  /* v8-revision: feed-degradering färgar INTE om hela badgen (skulle se ut
     som att reglerna är degraderade). Bara .freshness__feednote markeras. */
  .freshness__feednote { color: var(--warn-ink); font-weight: 600; }
  /* .pill sätter display — utan detta vinner den över [hidden] och en tom badge syns. */
  .freshness[hidden] { display: none; }
</style>
