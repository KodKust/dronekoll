---
/**
 * Fördelspunkter på feature-sidorna — mjuk 2×2-struktur (en kolumn på mobil)
 * med diskret monokrom ikon och befintlig text (inga nya formuleringar,
 * ingen ny översättning). Ersätter den tunna bulletlistan efter produkt-heron.
 */
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<ul class="benefits">
  {items.map((text) => (
    <li class="benefit">
      <span class="benefit__ico" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M8.5 12.5l2.4 2.4 4.6-5.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="benefit__text">{text}</span>
    </li>
  ))}
</ul>

<style>
  .benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .benefit {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    background: var(--surface-card);
    border: 1px solid var(--sky-border);
    border-radius: var(--r-md);
    padding: var(--space-5);
  }
  .benefit__ico { flex-shrink: 0; color: var(--ink-2); margin-top: 2px; }
  .benefit__text { color: var(--ink-body); min-width: 0; }
  @media (max-width: 720px) {
    .benefits { grid-template-columns: 1fr; }
  }
</style>
