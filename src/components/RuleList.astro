---
/**
 * Regellistan (landssidor) — varje befintlig punkt får en egen lugn regelrad:
 * nästan vit yta, diskret blågrå kant, generös padding och ett neutralt
 * nummer i separat kolumn (ekar källkortens bokstavschip). Text och ordning
 * ändras ALDRIG här. REN lista: inga per-rad-statusar/ikoner — översynsdatum
 * visas separat via FreshnessBadge; legal-registret/legalStatus är ett
 * INTERNT arbetsverktyg och surfas inte (Kristoffers beslut 2026-07-24).
 * Ingen stagger: reglerna ska stå i sidan direkt, även vid #rules-djuplänk.
 */
interface Props {
  rules: string[];
}
const { rules } = Astro.props;
---

<ol class="rules">
  {rules.map((text, i) => (
    <li class="rules__row">
      <span class="rules__num tnum" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <span class="rules__text">{text}</span>
    </li>
  ))}
</ol>

<style>
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    max-width: var(--w-prose);
  }
  .rules__row {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    background: var(--surface-card);
    border: 1px solid var(--sky-border);
    border-radius: var(--r-md);
    padding: var(--space-4) var(--space-5);
  }
  .rules__num {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin-top: 1px;
    border-radius: var(--r-sm);
    background: var(--soft-btn);
    color: var(--ink-2);
    font-size: var(--text-caption);
    font-weight: 640;
  }
  .rules__text { color: var(--ink-body); min-width: 0; }
</style>
