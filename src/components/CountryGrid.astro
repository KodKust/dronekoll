---
/**
 * Landskort-grid (hem + hubbar + relaterade länder). Cirkelflagga = SVG
 * (HatScripts circle-flags, MIT) — ALDRIG emoji (Windows renderar emoji-
 * flaggor som bokstavspar). Sökningen bor i CountrySearch.astro (filtrerar
 * alla .cgrid-kort på sidan). Ingen stagger: 55 kort ska synas direkt.
 */
import { t } from '../lib/i18n';
import type { PageEntry } from '../lib/model';

interface Props {
  lang: string;
  pages: PageEntry[];
}
const { lang, pages } = Astro.props;
---

<ul class="cgrid">
  {pages.map((p) => (
    <li>
      <a
        class="card card--hover cgrid__card"
        href={p.urlPath}
        data-names={`${p.displayName} ${p.iso}`.toLowerCase()}
      >
        <img
          class="cgrid__flag"
          src={`/flags/${p.iso.toLowerCase()}.svg`}
          width="28"
          height="28"
          alt=""
          loading="lazy"
          decoding="async"
        />
        <span class="cgrid__name">{p.displayName}</span>
        <span class={`pill cgrid__badge ${p.country.hasAirspaceOverlay ? 'cgrid__badge--zones' : ''}`}>
          {p.country.hasAirspaceOverlay
            ? t('grid.overlayBadge', lang)
            : p.country.hasNotam
              ? t('grid.notamBadge', lang)
              : t('grid.rulesBadge', lang)}
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .cgrid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-4);
  }
  .cgrid__card {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    gap: 4px var(--space-3);
    align-items: center;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--r-lg);
    color: inherit;
  }
  .cgrid__card:hover { text-decoration: none; }
  .cgrid__flag { width: 28px; height: 28px; grid-row: span 2; border-radius: 50%; }
  .cgrid__name { font-weight: 600; color: var(--ink); }
  .cgrid__badge {
    justify-self: start;
    padding: 1px 10px;
    font-size: var(--text-caption);
    background: var(--soft-btn);
    color: var(--ink-2);
  }
  .cgrid__badge--zones { background: var(--accent-wash); color: var(--accent-ink); }
</style>
